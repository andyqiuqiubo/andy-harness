static const char *BROWSE_CAP  = $label_browse_caption;
static const char *BTN_INSTALL = $label_install;
static const char *BTN_CANCEL  = $label_cancel;
static const char *MSG_CANCEL  = $msg_cancel_confirm;
static const char *MSG_DONE    = $msg_done;
static const char *DEFAULT_DEST= $default_dest;
static const char *EXTRACTOR   = $extractor_path;
static const int   HAS_PAYLOAD = $has_payload;
