#define BIF_NEWDIALOGSTYLE 0x0040
#define WM_APP_PROGRESS (WM_APP + 1)
#define WM_APP_DONE     (WM_APP + 2)
#define WM_APP_FAILED   (WM_APP + 3)
#define TRAILER_SIZE    24

