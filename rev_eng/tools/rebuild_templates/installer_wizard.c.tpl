/* ---- shell32 resolved at runtime (tcc has no shell32 import lib/header) ---- */
typedef struct tagBROWSEINFOA {
    HWND hwndOwner; void *pidlRoot; char *pszDisplayName; char *lpszTitle;
    UINT ulFlags; void *lpfn; LPARAM lParam; int iImage;
} BROWSEINFOA;
typedef void *(WINAPI *PFN_SHBROWSE)(BROWSEINFOA *);
typedef int (WINAPI *PFN_SHPATH)(const void *, char *);

static void *sh_browse_folder(HWND owner, const char *title, char *outPath, int outLen)
{
    HMODULE h = LoadLibrary("shell32.dll");
    PFN_SHBROWSE f;
    PFN_SHPATH p;
    BROWSEINFOA bi;
    char display[MAX_PATH];
    void *pidl;

    outPath[0] = 0;
    if (!h) return 0;
    f = (PFN_SHBROWSE)(void *)GetProcAddress(h, "SHBrowseForFolderA");
    p = (PFN_SHPATH)(void *)GetProcAddress(h, "SHGetPathFromIDListA");
    if (!f) return 0;
    memset(&bi, 0, sizeof(bi));
    bi.hwndOwner = owner;
    bi.pszDisplayName = display;
    bi.lpszTitle = (char *)title;
    bi.ulFlags = BIF_RETURNONLYDIRS | BIF_NEWDIALOGSTYLE;
    pidl = f(&bi);
    if (!pidl) return 0;
    if (p && p(pidl, outPath)) {
        /* directory chosen */
    } else {
        outPath[0] = 0;
    }
    return pidl;
}

/* ---- read this exe's own overlay payload (stub+overlay SFX layout) ---- */
static int read_own_payload(char *outPath, int outLen, unsigned long *outSize)
{
    char self[MAX_PATH];
    HANDLE h;
    unsigned char tr[TRAILER_SIZE];
    DWORD got = 0, size;
    unsigned long long off = 0, psz = 0;
    char *buf;
    HANDLE fo;
    DWORD wrote = 0;
    char tmpDir[MAX_PATH], tmpFile[MAX_PATH];

    if (!GetModuleFileNameA(NULL, self, sizeof(self))) return 0;
    h = CreateFileA(self, GENERIC_READ, FILE_SHARE_READ, NULL, OPEN_EXISTING,
                    FILE_ATTRIBUTE_NORMAL, NULL);
    if (h == INVALID_HANDLE_VALUE) return 0;
    size = GetFileSize(h, NULL);
    if (size == INVALID_FILE_SIZE || size < TRAILER_SIZE + 8) { CloseHandle(h); return 0; }
    SetFilePointer(h, (LONG)(size - TRAILER_SIZE), NULL, FILE_BEGIN);
    if (!ReadFile(h, tr, TRAILER_SIZE, &got, NULL) || got != TRAILER_SIZE) {
        CloseHandle(h); return 0;
    }
    if (memcmp(tr + 16, "AHRPLD1", 7) != 0 || tr[23] != 0) { CloseHandle(h); return 0; }
    memcpy(&off, tr, 8);
    memcpy(&psz, tr + 8, 8);
    if (off + psz + TRAILER_SIZE > (unsigned long long)size || psz == 0) {
        CloseHandle(h); return 0;
    }
    buf = (char *)HeapAlloc(GetProcessHeap(), 0, (SIZE_T)psz);
    if (!buf) { CloseHandle(h); return 0; }
    SetFilePointer(h, (LONG)off, NULL, FILE_BEGIN);
    if (!ReadFile(h, buf, (DWORD)psz, &got, NULL) || got != psz) {
        HeapFree(GetProcessHeap(), 0, buf); CloseHandle(h); return 0;
    }
    CloseHandle(h);

    GetTempPathA(sizeof(tmpDir), tmpDir);
    GetTempFileNameA(tmpDir, "ahr", 0, tmpFile);
    fo = CreateFileA(tmpFile, GENERIC_WRITE, 0, NULL, CREATE_ALWAYS,
                     FILE_ATTRIBUTE_TEMPORARY, NULL);
    if (fo == INVALID_HANDLE_VALUE) {
        HeapFree(GetProcessHeap(), 0, buf); return 0;
    }
    WriteFile(fo, buf, (DWORD)psz, &wrote, NULL);
    CloseHandle(fo);
    HeapFree(GetProcessHeap(), 0, buf);
    lstrcpyn(outPath, tmpFile, outLen);
    *outSize = (unsigned long)psz;
    return 1;
}

/* ---- progress: last "NN%" in the extractor output ---- */
static int last_percent(const char *text)
{
    int i, n = lstrlen(text), best = -1;
    for (i = n - 2; i >= 0; i--) {
        if (text[i] == '%') {
            int j = i - 1, v = 0, mul = 1, digits = 0;
            while (j >= 0 && text[j] >= '0' && text[j] <= '9' && digits < 3) {
                v += (text[j] - '0') * mul; mul *= 10; digits++; j--;
            }
            if (digits > 0 && v <= 100) { best = v; break; }
        }
    }
    return best;
}

/* ---- install worker thread ---- */
typedef struct tagINSTALLCTX {
    char dest[MAX_PATH];
    char payload[MAX_PATH];
    char log[MAX_PATH];
    unsigned long size;
} INSTALLCTX;

static DWORD WINAPI install_thread(void *arg)
{
    INSTALLCTX *ic = (INSTALLCTX *)arg;
    char cmd[2048], self[MAX_PATH], extractor[MAX_PATH];
    STARTUPINFOA si;
    PROCESS_INFORMATION pi;
    DWORD waited;
    int pct, lastPct = -1;
    char *logbuf;
    DWORD logSize = 0;
    HANDLE lf;

    if (!GetModuleFileNameA(NULL, self, sizeof(self))) self[0] = 0;
    /* extractor lookup: build-time path -> exe dir (7z.exe/7za.exe) -> PATH */
    lstrcpyn(extractor, EXTRACTOR, sizeof(extractor));
    if (!extractor[0] || GetFileAttributesA(extractor) == INVALID_FILE_ATTRIBUTES) {
        char local[MAX_PATH], *cut;
        static const char *names[] = { "7z.exe", "7za.exe" };
        int k;
        lstrcpyn(local, self, sizeof(local));
        cut = strrchr(local, '\\');
        if (cut) {
            for (k = 0; k < 2; k++) {
                *(cut + 1) = 0;
                lstrcat(local, names[k]);
                if (GetFileAttributesA(local) != INVALID_FILE_ATTRIBUTES) {
                    lstrcpyn(extractor, local, sizeof(extractor));
                    break;
                }
            }
        }
    }
    if (!extractor[0] || GetFileAttributesA(extractor) == INVALID_FILE_ATTRIBUTES) {
        char found[MAX_PATH];
        if (SearchPathA(NULL, "7z.exe", NULL, sizeof(found), found, NULL))
            lstrcpyn(extractor, found, sizeof(extractor));
        else if (SearchPathA(NULL, "7za.exe", NULL, sizeof(found), found, NULL))
            lstrcpyn(extractor, found, sizeof(extractor));
    }

    CreateDirectoryA(ic->dest, NULL);
    memset(&si, 0, sizeof(si));
    si.cb = sizeof(si);
    memset(&pi, 0, sizeof(pi));

    if (extractor[0] && GetFileAttributesA(extractor) != INVALID_FILE_ATTRIBUTES) {
        wsprintf(cmd, "cmd.exe /C \"\"%s\" x -y -o\"%s\" \"%s\" > \"%s\" 2>&1\"",
                 extractor, ic->dest, ic->payload, ic->log);
        if (CreateProcessA(NULL, cmd, NULL, NULL, TRUE, 0, NULL, NULL, &si, &pi)) {
            for (;;) {
                waited = WaitForSingleObject(pi.hProcess, 200);
                lf = CreateFileA(ic->log, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE,
                                 NULL, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, NULL);
                if (lf != INVALID_HANDLE_VALUE) {
                    logSize = GetFileSize(lf, NULL);
                    if (logSize > 0 && logSize < 262144) {
                        logbuf = (char *)HeapAlloc(GetProcessHeap(), 0, logSize + 1);
                        if (logbuf) {
                            DWORD rd = 0;
                            SetFilePointer(lf, 0, NULL, FILE_BEGIN);
                            if (ReadFile(lf, logbuf, logSize, &rd, NULL)) {
                                logbuf[rd] = 0;
                                pct = last_percent(logbuf);
                                if (pct > lastPct) {
                                    lastPct = pct;
                                    PostMessage(g_hDlg, WM_APP_PROGRESS, (WPARAM)pct, 0);
                                }
                            }
                            HeapFree(GetProcessHeap(), 0, logbuf);
                        }
                    }
                    CloseHandle(lf);
                }
                if (waited == WAIT_OBJECT_0) break;
            }
            GetExitCodeProcess(pi.hProcess, &waited);
            CloseHandle(pi.hProcess);
            CloseHandle(pi.hThread);
            if (waited == 0) {
                PostMessage(g_hDlg, WM_APP_DONE, 100, 0);
            } else {
                PostMessage(g_hDlg, WM_APP_FAILED, waited, 0);
            }
        } else {
            PostMessage(g_hDlg, WM_APP_FAILED, (WPARAM)GetLastError(), 0);
        }
    } else {
        /* no extractor: release the payload file as-is (honest degradation) */
        char target[MAX_PATH * 2], *cut;
        int i;
        lstrcpyn(target, ic->dest, sizeof(target));
        if (lstrlen(target) && target[lstrlen(target) - 1] != '\\') lstrcat(target, "\\");
        cut = strrchr(ic->payload, '\\');
        lstrcat(target, cut ? cut + 1 : "payload.bin");
        CopyFileA(ic->payload, target, FALSE);
        for (i = 0; i <= 100; i += 10) {
            PostMessage(g_hDlg, WM_APP_PROGRESS, (WPARAM)i, 0);
            Sleep(120);
        }
        PostMessage(g_hDlg, WM_APP_DONE, 100, 0);
    }
    DeleteFileA(ic->payload);
    DeleteFileA(ic->log);
    HeapFree(GetProcessHeap(), 0, ic);
    return 0;
}

static void start_install(HWND hDlg)
{
    INSTALLCTX *ic;
    char dest[MAX_PATH];
    HANDLE th;

    if (g_busy) return;
    if (ID_DEST_EDIT) {
        GetDlgItemTextA(hDlg, ID_DEST_EDIT, dest, sizeof(dest));
    } else {
        lstrcpyn(dest, DEFAULT_DEST, sizeof(dest));
    }
    if (!dest[0]) {
        MessageBoxA(hDlg, "Please select a destination folder first.", "Setup",
                    MB_OK | MB_ICONWARNING);
        return;
    }
    g_busy = 1;
    if (ID_PROGRESS) {
        SendDlgItemMessageA(hDlg, ID_PROGRESS, PBM_SETRANGE, 0, MAKELPARAM(0, 100));
        SendDlgItemMessageA(hDlg, ID_PROGRESS, PBM_SETPOS, 0, 0);
    }
    ic = (INSTALLCTX *)HeapAlloc(GetProcessHeap(), 0, sizeof(INSTALLCTX));
    if (!ic) { g_busy = 0; return; }
    memset(ic, 0, sizeof(INSTALLCTX));
    lstrcpyn(ic->dest, dest, sizeof(ic->dest));
    GetTempPathA(sizeof(ic->log), ic->log);
    lstrcat(ic->log, "ahr-install.log");
    if (HAS_PAYLOAD && read_own_payload(ic->payload, sizeof(ic->payload), &ic->size)) {
        th = CreateThread(NULL, 0, install_thread, ic, 0, NULL);
        if (th) CloseHandle(th);
        else { g_busy = 0; HeapFree(GetProcessHeap(), 0, ic); }
    } else {
        /* no payload: progress demo + clear notice (writes nothing) */
        int i;
        for (i = 0; i <= 100; i += 20) {
            if (ID_PROGRESS)
                SendDlgItemMessageA(hDlg, ID_PROGRESS, PBM_SETPOS, (WPARAM)i, 0);
            Sleep(100);
        }
        MessageBoxA(hDlg,
                    "No embedded payload was found in this build, so nothing was\n"
                    "installed. This is a demonstration of the reconstructed UI.",
                    "Setup", MB_OK | MB_ICONINFORMATION);
        g_busy = 0;
        HeapFree(GetProcessHeap(), 0, ic);
    }
}

static INT_PTR CALLBACK DlgProc(HWND hDlg, UINT msg, WPARAM wp, LPARAM lp)
{
    switch (msg) {
    case WM_INITDIALOG: {
        HICON ic;
        g_hDlg = hDlg;
        if (g_bigIcon) SendMessageA(hDlg, WM_SETICON, ICON_BIG, (LPARAM)g_bigIcon);
        if (g_iconPath[0]) {
            ic = (HICON)LoadImageA(NULL, g_iconPath, IMAGE_ICON, 16, 16, LR_LOADFROMFILE);
            if (ic) SendMessageA(hDlg, WM_SETICON, ICON_SMALL, (LPARAM)ic);
        }
        if (ID_DEST_EDIT && DEFAULT_DEST[0])
            SetDlgItemTextA(hDlg, ID_DEST_EDIT, DEFAULT_DEST);
        if (ID_PROGRESS) {
            SendDlgItemMessageA(hDlg, ID_PROGRESS, PBM_SETRANGE, 0, MAKELPARAM(0, 100));
            SendDlgItemMessageA(hDlg, ID_PROGRESS, PBM_SETPOS, 0, 0);
        }
        return TRUE;
    }

    case WM_APP_PROGRESS:
        if (ID_PROGRESS)
            SendDlgItemMessageA(hDlg, ID_PROGRESS, PBM_SETPOS, wp, 0);
        return TRUE;

    case WM_APP_DONE:
        g_busy = 0;
        MessageBoxA(hDlg, MSG_DONE, "Setup", MB_OK | MB_ICONINFORMATION);
        return TRUE;

    case WM_APP_FAILED:
        g_busy = 0;
        if (ID_PROGRESS)
            SendDlgItemMessageA(hDlg, ID_PROGRESS, PBM_SETPOS, 0, 0);
        MessageBoxA(hDlg,
                    "The external extractor failed. The payload file was left in the\n"
                    "destination folder (if writable) so you can extract it manually.",
                    "Setup", MB_OK | MB_ICONWARNING);
        return TRUE;

    case WM_COMMAND:
        if (ID_BROWSE && LOWORD(wp) == ID_BROWSE) {
            char path[MAX_PATH];
            sh_browse_folder(hDlg, BROWSE_CAP, path, sizeof(path));
            if (path[0] && ID_DEST_EDIT) SetDlgItemTextA(hDlg, ID_DEST_EDIT, path);
            return TRUE;
        }
        if (ID_INSTALL && LOWORD(wp) == ID_INSTALL) {
            start_install(hDlg);
            return TRUE;
        }
        if (ID_CANCEL && LOWORD(wp) == ID_CANCEL) {
            if (!g_busy && MessageBoxA(hDlg, MSG_CANCEL, "Setup",
                                      MB_YESNO | MB_ICONQUESTION) == IDYES)
                EndDialog(hDlg, 0);
            return TRUE;
        }
        if (LOWORD(wp) == IDCANCEL) {
            if (!g_busy) EndDialog(hDlg, 0);
            return TRUE;
        }
        return FALSE;

    case WM_CLOSE:
        if (g_busy) return TRUE;
        EndDialog(hDlg, 0);
        return TRUE;
    }
    return FALSE;
}

int WINAPI WinMain(HINSTANCE hInst, HINSTANCE hPrev, LPSTR cmd, int show)
{
    MSG msg;
    HMODULE cc;
    void (WINAPI *icc)(void);
    HWND hDlg;

    if (g_iconPath[0] == 0 && $has_icon)
        lstrcpyn(g_iconPath, $icon_path, sizeof(g_iconPath));

    cc = LoadLibrary("comctl32.dll");  /* progress bar needs InitCommonControls */
    if (cc) {
        icc = (void (WINAPI *)(void))(void *)GetProcAddress(cc, "InitCommonControls");
        if (icc) icc();
    }
    if (g_iconPath[0]) {
        g_bigIcon = (HICON)LoadImageA(NULL, g_iconPath, IMAGE_ICON, 32, 32, LR_LOADFROMFILE);
    }

    if (DLG_TEMPLATE_LEN < 18) {
        MessageBoxA(NULL, "Dialog template is missing in this build.", "Setup",
                    MB_OK | MB_ICONERROR);
        return 1;
    }
    hDlg = CreateDialogIndirectParamA(hInst, (const DLGTEMPLATE *)DLG_TEMPLATE, NULL,
                                      DlgProc, 0);
    if (!hDlg) {
        MessageBoxA(NULL, "Failed to create the dialog from the sample template.",
                    "Setup", MB_OK | MB_ICONERROR);
        return 1;
    }
    ShowWindow(hDlg, show);
    UpdateWindow(hDlg);

    while (GetMessage(&msg, NULL, 0, 0)) {
        if (!IsDialogMessage(hDlg, &msg)) {
            TranslateMessage(&msg);
            DispatchMessage(&msg);
        }
    }
    return (int)msg.wParam;
}
