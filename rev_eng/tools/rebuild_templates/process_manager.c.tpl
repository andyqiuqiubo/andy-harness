/* ---- ntdll!NtQuerySystemInformation (SystemProcessInformation) ----
   Same data channel real process explorers use: one syscall returns
   working set / private bytes / CPU time for every process without any
   OpenProcess call, so protected processes are visible even without
   SeDebugPrivilege. x64 layout, offsets annotated inline. */
#define SYS_PROC_INFO 5
typedef struct tagUNISTR { USHORT Length; USHORT MaximumLength; PWSTR Buffer; } UNISTR;
typedef struct tagSYSPL {
    ULONG NextEntryOffset;          /* 0x00 */
    ULONG NumberOfThreads;          /* 0x04 */
    unsigned __int64 WorkingSetHint;/* 0x08 */
    ULONG HardFaultCount;           /* 0x10 */
    ULONG ThreadsHighWatermark;     /* 0x14 */
    unsigned __int64 CycleTime;     /* 0x18 */
    unsigned __int64 CreateTime;    /* 0x20 */
    unsigned __int64 UserTime;      /* 0x28 */
    unsigned __int64 KernelTime;    /* 0x30 */
    UNISTR ImageName;               /* 0x38 (16 bytes on x64) */
    LONG BasePriority;              /* 0x48 */
    void *UniqueProcessId;          /* 0x50 */
    void *InheritedFromProcessId;   /* 0x58 */
    ULONG HandleCount;              /* 0x60 */
    ULONG SessionId;                /* 0x64 */
    SIZE_T PeakVirtualSize;         /* 0x68 */
    SIZE_T VirtualSize;             /* 0x70 */
    SIZE_T PageFaultCount;          /* 0x78 */
    SIZE_T PeakWorkingSetSize;      /* 0x80 */
    SIZE_T WorkingSetSize;          /* 0x88 */
    SIZE_T QuotaPeakPagedPoolUsage; /* 0x90 */
    SIZE_T QuotaPagedPoolUsage;     /* 0x98 */
    SIZE_T QuotaPeakNonPagedPoolUsage; /* 0xA0 */
    SIZE_T QuotaNonPagedPoolUsage;  /* 0xA8 */
    SIZE_T PagefileUsage;           /* 0xB0 */
    SIZE_T PeakPagefileUsage;       /* 0xB8 */
    SIZE_T PrivatePageCount;        /* 0xC0 */
    /* SYSTEM_THREADS threads[] follows at 0xC8 */
} SYSPL;
typedef LONG (WINAPI *PFN_NQSI)(ULONG, void *, ULONG, ULONG *);

typedef union _FTU { FILETIME ft; unsigned __int64 u64; } FTU;
typedef BOOL (WINAPI *PFN_SYSTIMES)(FTU *, FTU *, FTU *);

/* ---- version info ---- */
