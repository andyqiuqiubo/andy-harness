{
    char msg[768];
    if (i < 0 || i >= nrows) return;
    wsprintf(msg,
        "name     : %s\npid      : %lu\nparent   : %lu\nthreads  : %lu\n"
        "cpu      : %d.%02d %%\nprivate  : %lu K\nworking set: %lu K\n"
        "description: %s\ncompany  : %s",
        rows[i].exe, (unsigned long)rows[i].pid, (unsigned long)rows[i].ppid,
        (unsigned long)rows[i].threads, rows[i].cpu / 100, rows[i].cpu % 100,
        (unsigned long)rows[i].privKb, (unsigned long)rows[i].wsKb,
        rows[i].desc[0] ? rows[i].desc : "(n/a)",
        rows[i].comp[0] ? rows[i].comp : "(n/a)");
    MessageBox(hwnd, msg, rows[i].exe, MB_OK);
