static void load_apis(void)
{
    HMODULE k32 = GetModuleHandle("kernel32.dll");
    HMODULE ntdll = GetModuleHandle("ntdll.dll");
    HMODULE h;
    fNQSI = (PFN_NQSI)(void *)GetProcAddress(ntdll, "NtQuerySystemInformation");
    fSysTimes = (PFN_SYSTIMES)(void *)GetProcAddress(k32, "GetSystemTimes");
    h = LoadLibrary("version.dll");
    if (h) {
        fVFIS = (PFN_VFIS)(void *)GetProcAddress(h, "GetFileVersionInfoSizeA");
        fVFI  = (PFN_VFI)(void *)GetProcAddress(h, "GetFileVersionInfoA");
        fVQV  = (PFN_VQV)(void *)GetProcAddress(h, "VerQueryValueA");
    }
}

static void query_version(const char *exe, char *desc, int dlen, char *comp, int clen)
{
    DWORD sz, h = 0;
    char *buf;
    void *tr = 0, *val = 0;
    UINT tl = 0, vl = 0;
    unsigned langcp;
    char sub[160];

    desc[0] = 0; comp[0] = 0;
    if (!fVFIS || !fVFI || !fVQV) return;
    sz = fVFIS(exe, &h);
    if (!sz) return;
    buf = (char *)HeapAlloc(GetProcessHeap(), 0, sz);
    if (!buf) return;
    if (fVFI(exe, 0, sz, buf) &&
        fVQV(buf, "\\VarFileInfo\\Translation", &tr, &tl) && tl >= 4 && tr) {
        langcp = *(unsigned *)tr;
        wsprintf(sub, "\\StringFileInfo\\%04X%04X\\FileDescription",
                 langcp & 0xFFFF, (langcp >> 16) & 0xFFFF);
        if (fVQV(buf, sub, &val, &vl) && val && vl > 1)
            lstrcpyn(desc, (const char *)val, dlen);
        wsprintf(sub, "\\StringFileInfo\\%04X%04X\\CompanyName",
                 langcp & 0xFFFF, (langcp >> 16) & 0xFFFF);
        if (fVQV(buf, sub, &val, &vl) && val && vl > 1)
            lstrcpyn(comp, (const char *)val, clen);
    }
    HeapFree(GetProcessHeap(), 0, buf);
}

/* Resolve a process image path: try QueryFullProcessImageNameA first,
   fall back to probing System32 because most protected processes are
   inbox Windows binaries. */
static void resolve_path(DWORD pid, const char *exe, char *out, int outlen)
{
    typedef DWORD (WINAPI *PFN_GMFN)(HANDLE, DWORD, char *, DWORD *);
    static PFN_GMFN fGMFN = 0;
    HANDLE ph;
    char sysdir[MAX_PATH], cand[MAX_PATH * 2];
    int n;

    out[0] = 0;
    if (!fGMFN) {
        HMODULE k32 = GetModuleHandle("kernel32.dll");
        fGMFN = (PFN_GMFN)(void *)GetProcAddress(k32, "QueryFullProcessImageNameA");
    }
    ph = OpenProcess(PROCESS_QUERY_LIMITED, FALSE, pid);
    if (ph && fGMFN) {
        n = (int)sizeof(cand);
        if (fGMFN(ph, 0, cand, (DWORD *)&n)) {
            lstrcpyn(out, cand, outlen);
            CloseHandle(ph);
            return;
        }
    }
    if (ph) CloseHandle(ph);
    /* fallback: System32\<name> */
    n = GetSystemDirectory(sysdir, sizeof(sysdir));
    if (n > 0 && n < (int)sizeof(sysdir)) {
        int i;
        wsprintf(cand, "%s\\%s", sysdir, exe);
        for (i = 0; cand[i]; i++) cand[i] = (char)tolower((unsigned char)cand[i]);
        if (GetFileAttributes(cand) != INVALID_FILE_ATTRIBUTES) {
            lstrcpyn(out, cand, outlen);
            return;
        }
    }
}

static void version_cached(const char *exe, DWORD pid,
                           char *desc, int dlen, char *comp, int clen)
{
    int i;
    char path[MAX_PATH * 2];
    for (i = 0; i < g_nvcache; i++) {
        if (!lstrcmpi(g_vcache[i].exe, exe)) {
            lstrcpyn(desc, g_vcache[i].desc, dlen);
            lstrcpyn(comp, g_vcache[i].comp, clen);
            return;
        }
    }
    resolve_path(pid, exe, path, sizeof(path));
    if (path[0])
        query_version(path, desc, dlen, comp, clen);
    else {
        desc[0] = 0;
        comp[0] = 0;
    }
    if (g_nvcache < (int)(sizeof(g_vcache) / sizeof(g_vcache[0]))) {
        lstrcpyn(g_vcache[g_nvcache].exe, exe, sizeof(g_vcache[0].exe));
        lstrcpyn(g_vcache[g_nvcache].desc, desc, sizeof(g_vcache[0].desc));
        lstrcpyn(g_vcache[g_nvcache].comp, comp, sizeof(g_vcache[0].comp));
        g_nvcache++;
    }
}

static int find_prev_proc(DWORD pid)
{
    int i;
    for (i = 0; i < g_nPrevProc; i++)
        if (g_prevProc[i].pid == pid) return i;
    return -1;
}

static int is_service_name(const char *exe)
{
    static const char *names[] = {
        "system", "registry", "memory compression", "secure system",
        "svchost.exe", "csrss.exe", "wininit.exe", "winlogon.exe",
        "services.exe", "lsass.exe", "smss.exe", "dwm.exe",
        "fontdrvhost.exe", "wudfhost.exe", "audiodg.exe", "msmpeng.exe",
        "securityhealthservice.exe", "sgrmbroker.exe", "spoolsv.exe",
        "sihost.exe", "ctfmon.exe"
    };
    int i;
    for (i = 0; i < (int)(sizeof(names) / sizeof(names[0])); i++)
        if (!lstrcmpi(names[i], exe)) return 1;
    return 0;
}

