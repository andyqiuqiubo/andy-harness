        if (g_iconPath[0]) {
            ic = (HICON)LoadImage(NULL, g_iconPath, IMAGE_ICON, 16, 16, LR_LOADFROMFILE);
            if (ic) SendMessage(hwnd, WM_SETICON, 0, (LPARAM)ic);
        }
        load_apis();
        SetTimer(hwnd, 1, 1500, NULL);
        PostMessage(hwnd, WM_TIMER, 1, 0);
        return 0;
    }

    case WM_TIMER:
        refresh(hList);
        return 0;

    case WM_SIZE: {
        int w = LOWORD(lp), h = HIWORD(lp);
        MoveWindow(hList, 0, 26, w, h - 26 - 20, TRUE);
        MoveWindow(hStatus, 0, h - 20, w, 20, TRUE);
        return 0;
    }

    case WM_NOTIFY: {
        NMHDRX *nm = (NMHDRX *)lp;
        NMLVCDX *cd;
        if (nm->code == NM_CUSTOMDRAW) {
            cd = (NMLVCDX *)lp;
            if (cd->nmcd.dwDrawStage == CDDS_PREPAINT)
                return CDRF_NOTIFYITEMDRAW;
            if (cd->nmcd.dwDrawStage == CDDS_ITEMPREPAINT) {
                int i = (int)cd->nmcd.dwItemSpec;
                COLORREF bg = RGB(255, 255, 255);
                if (i >= 0 && i < nrows) {
                    if (rows[i].pid == g_myPid)
                        bg = RGB(198, 255, 198);
                    else if (is_service_name(rows[i].exe))
                        bg = RGB(252, 208, 222);
                }
                cd->clrTextBk = bg;
                return CDRF_NEWFONT;
            }
            return CDRF_DODEFAULT;
        }
        if (nm->idFrom == ID_LIST && nm->code == (UINT)NM_DBLCLK) {
            int sel = (int)SendMessage(hList, LVM_GETNEXTITEM,
                                       (WPARAM)LVNI_SELECTED, 0);
            show_row(hwnd, sel);
        }
        return 0;
    }

    case WM_COMMAND:
        switch (LOWORD(wp)) {
        case IDM_REFRESH:
            refresh(hList);
            return 0;
        case IDM_EXIT:
            PostQuitMessage(0);
            return 0;
        case IDM_ABOUT:
            show_about(hwnd);
            return 0;
        case IDM_FACTS:
            show_facts(hwnd);
            return 0;
        }
        return 0;

    case WM_DESTROY:
        PostQuitMessage(0);
        return 0;
    }
    return DefWindowProc(hwnd, msg, wp, lp);
}

int WINAPI WinMain(HINSTANCE hInst, HINSTANCE hPrev, LPSTR cmd, int show)
{
    WNDCLASS wc;
    HMENU menu, file, help;
    HWND hwnd;
    MSG msg;
    HICON big = 0;

    g_myPid = GetCurrentProcessId();
    if (g_iconPath[0] == 0 && $has_icon)
        lstrcpyn(g_iconPath, $icon_path, sizeof(g_iconPath));

    memset(&wc, 0, sizeof(wc));
    wc.lpfnWndProc   = WndProc;
    wc.hInstance     = hInst;
    wc.lpszClassName = "AndyHarnessRebuilt";
    wc.hbrBackground = (HBRUSH)(COLOR_WINDOW + 1);
    wc.hCursor       = LoadCursor(NULL, IDC_ARROW);
    if (g_iconPath[0]) {
        big = (HICON)LoadImage(NULL, g_iconPath, IMAGE_ICON, 32, 32, LR_LOADFROMFILE);
        if (big) wc.hIcon = big;
    }
    if (!wc.hIcon) wc.hIcon = LoadIcon(NULL, IDI_APPLICATION);
    RegisterClass(&wc);

    menu = CreateMenu();
    file = CreatePopupMenu();
    AppendMenu(file, MF_STRING, IDM_REFRESH, "&Refresh\tF5");
    AppendMenu(file, MF_SEPARATOR, 0, NULL);
    AppendMenu(file, MF_STRING, IDM_EXIT, "E&xit");
    AppendMenu(menu, MF_POPUP, (UINT_PTR)file, "&File");
    help = CreatePopupMenu();
    AppendMenu(help, MF_STRING, IDM_FACTS, "Reverse &Facts");
    AppendMenu(help, MF_STRING, IDM_ABOUT, "&About");
    AppendMenu(menu, MF_POPUP, (UINT_PTR)help, "&Help");

    hwnd = CreateWindowEx(0, "AndyHarnessRebuilt", TITLE,
        WS_OVERLAPPEDWINDOW, CW_USEDEFAULT, CW_USEDEFAULT, 1020, 640,
        NULL, menu, hInst, NULL);
    ShowWindow(hwnd, show);
    UpdateWindow(hwnd);

    while (GetMessage(&msg, NULL, 0, 0)) {
        TranslateMessage(&msg);
        DispatchMessage(&msg);
    }
    return (int)msg.wParam;
}
