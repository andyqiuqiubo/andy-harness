static void update_status(int totalCpu)
{
    char buf[512];
    typedef BOOL (WINAPI *PFN_GMSE)(void *);
    static PFN_GMSE fGMSE = 0;
    /* layout matches what GlobalMemoryStatusEx expects */
    struct { DWORD dwLength; DWORD dwMemoryLoad;
             unsigned __int64 tp, ap, tpf, apf, tv, av, aev; } ms;
    if (!fGMSE) {
        HMODULE k32 = GetModuleHandle("kernel32.dll");
        fGMSE = (PFN_GMSE)(void *)GetProcAddress(k32, "GlobalMemoryStatusEx");
    }
    memset(&ms, 0, sizeof(ms));
    ms.dwLength = sizeof(ms);
    if (fGMSE && fGMSE(&ms)) {
        unsigned long totalMB = (unsigned long)(ms.tp >> 20);
        unsigned long availMB = (unsigned long)(ms.ap >> 20);
        unsigned long usedMB  = totalMB - availMB;
        unsigned long pfTotal = (unsigned long)(ms.tpf >> 20);
        unsigned long pfUsed  = pfTotal - (unsigned long)(ms.apf >> 20);
        int pfPct = pfTotal ? (int)(pfUsed * 100 / pfTotal) : 0;
        wsprintf(buf,
            "CPU Usage: %d.%02d%%    Commit Charge: %d%%    Physical Usage: %d%% (%lu / %lu MB)    Processes: %d",
            totalCpu / 100, totalCpu % 100, pfPct, ms.dwMemoryLoad,
            usedMB, totalMB, nrows);
    } else {
        wsprintf(buf, "CPU Usage: %d.%02d%%    Processes: %d",
                 totalCpu / 100, totalCpu % 100, nrows);
    }
    SetWindowText(hStatus, buf);
}

static void refresh(HWND lv)
{
    ULONG need = 0;
    void *buf = NULL;
    SYSPL *p;
    int i, n = 0;
    FTU idleT, kerT, usrT;
    unsigned __int64 total = 0, dTotal = 0;
    int sysCpu = 0;
    int pvPrev = g_nPrevProc;
    PCPU prevOld[1024];

    memcpy(prevOld, g_prevProc, sizeof(PCPU) * (size_t)pvPrev);

    if (fSysTimes && fSysTimes(&idleT, &kerT, &usrT)) {
        total = kerT.u64 + usrT.u64;
        if (g_prevTotal && total > g_prevTotal) {
            unsigned __int64 dBusy;
            dTotal = total - g_prevTotal;
            dBusy = (total - idleT.u64 > g_prevBusy) ? (total - idleT.u64 - g_prevBusy) : 0;
            sysCpu = dTotal ? (int)(dBusy * 10000 / dTotal) : 0;
        }
        g_prevBusy = total - idleT.u64;
        g_prevTotal = total;
    }

    if (!fNQSI) return;
    /* two-pass: probe required size, then take the snapshot */
    fNQSI(SYS_PROC_INFO, NULL, 0, &need);
    if (need == 0) need = 1 << 20;
    for (i = 0; i < 4; i++) {
        buf = HeapAlloc(GetProcessHeap(), 0, need);
        if (!buf) return;
        if (fNQSI(SYS_PROC_INFO, buf, need, &need) >= 0) break;
        HeapFree(GetProcessHeap(), 0, buf);
        buf = NULL;
        need *= 2;
    }
    if (!buf) return;

    memset(rows, 0, sizeof(rows));
    memset(snapTime, 0, sizeof(snapTime));
    p = (SYSPL *)buf;
    for (;;) {
        if (n < (int)(sizeof(rows) / sizeof(rows[0]))) {
            ROW *r = &rows[n];
            r->pid = (DWORD)(ULONG_PTR)p->UniqueProcessId;
            r->ppid = (DWORD)(ULONG_PTR)p->InheritedFromProcessId;
            r->threads = p->NumberOfThreads;
            if (p->ImageName.Buffer && p->ImageName.Length) {
                typedef int (WINAPI *PFN_W2M)(UINT, DWORD, const wchar_t *, int,
                                              char *, int, const char *, int);
                static PFN_W2M w2m = 0;
                if (!w2m) {
                    HMODULE k32 = GetModuleHandle("kernel32.dll");
                    w2m = (PFN_W2M)(void *)GetProcAddress(k32, "WideCharToMultiByte");
                }
                if (w2m) {
                    int maxc = (p->ImageName.Length / 2) < 63 ? (p->ImageName.Length / 2) : 63;
                    w2m(0, 0, p->ImageName.Buffer, maxc, r->exe, 63, NULL, 0);
                    r->exe[maxc] = 0;
                }
            }
            r->wsKb = (DWORD)(p->WorkingSetSize >> 10);
            r->privKb = (DWORD)(p->PrivatePageCount >> 10);
            snapTime[n] = p->KernelTime + p->UserTime;
            n++;
        }
        if (!p->NextEntryOffset) break;
        p = (SYSPL *)(void *)((char *)p + p->NextEntryOffset);
    }
    nrows = n;
    HeapFree(GetProcessHeap(), 0, buf);

    /* tree depth by walking parents (capped) */
    for (i = 0; i < nrows; i++) {
        int d = 0;
        DWORD q = rows[i].ppid;
        while (q && d < 12) {
            int j, hit = -1;
            for (j = 0; j < nrows; j++)
                if (rows[j].pid == q) { hit = j; break; }
            if (hit < 0) break;
            q = rows[hit].ppid;
            d++;
        }
        rows[i].depth = d;
    }

    /* per-proc cpu from kernel+user time deltas (no handle needed) */
    g_nPrevProc = 0;
    for (i = 0; i < nrows; i++) {
        int pi = find_prev_proc(rows[i].pid);
        unsigned __int64 now = snapTime[i];
        unsigned __int64 dProc = 0;
        if (pi >= 0 && now > prevOld[pi].t)
            dProc = now - prevOld[pi].t;
        rows[i].cpu = (dProc && dTotal) ? (int)(dProc * 10000 / dTotal) : 0;
        if (g_nPrevProc < (int)(sizeof(g_prevProc) / sizeof(g_prevProc[0]))) {
            g_prevProc[g_nPrevProc].pid = rows[i].pid;
            g_prevProc[g_nPrevProc].t = now;
            g_nPrevProc++;
        }
    }

    /* rebuild list */
    SendMessage(lv, WM_SETREDRAW, FALSE, 0);
    SendMessage(lv, LVM_DELETEALLITEMS, 0, 0);
    for (i = 0; i < nrows; i++) {
        LVIX lvi;
        char t[64];
        memset(&lvi, 0, sizeof(lvi));
        lvi.mask = LVIF_TEXT | LVIF_PARAM | LVIF_INDENT;
        lvi.iItem = i;
        lvi.pszText = rows[i].exe;
        lvi.lParam = (LONG_PTR)i;
        lvi.iIndent = rows[i].depth;
        SendMessage(lv, LVM_INSERTITEMA, 0, (LPARAM)&lvi);

        wsprintf(t, "%d.%02d", rows[i].cpu / 100, rows[i].cpu % 100);
        set_col(lv, i, 1, t);
        wsprintf(t, "%lu K", (unsigned long)rows[i].privKb);
        set_col(lv, i, 2, t);
        wsprintf(t, "%lu K", (unsigned long)rows[i].wsKb);
        set_col(lv, i, 3, t);
        wsprintf(t, "%lu", (unsigned long)rows[i].pid);
        set_col(lv, i, 4, t);
        wsprintf(t, "%lu", (unsigned long)rows[i].threads);
        set_col(lv, i, 5, t);
        version_cached(rows[i].exe, rows[i].pid, rows[i].desc, sizeof(rows[i].desc),
                       rows[i].comp, sizeof(rows[i].comp));
        set_col(lv, i, 6, rows[i].desc);
        set_col(lv, i, 7, rows[i].comp);
    }
    SendMessage(lv, WM_SETREDRAW, TRUE, 0);
    InvalidateRect(lv, NULL, FALSE);
    update_status(sysCpu);
}

