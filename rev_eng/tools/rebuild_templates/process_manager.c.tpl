    case WM_CREATE: {
        HMODULE cc = LoadLibrary("comctl32.dll");
        void (WINAPI *icc)(void);
        HICON ic;
        if (cc) {
            icc = (void (WINAPI *)(void))(void *)GetProcAddress(cc, "InitCommonControls");
            if (icc) icc();
        }
        hList = CreateWindowEx(WS_EX_CLIENTEDGE, "SysListView32", "",
            WS_CHILD | WS_VISIBLE | WS_VSCROLL | LVS_REPORT | LVS_SHOWSELALWAYS,
            0, 26, 0, 0, hwnd, (HMENU)ID_LIST, GetModuleHandle(NULL), NULL);
        SendMessage(hList, WM_SETFONT, (WPARAM)GetStockObject(DEFAULT_GUI_FONT), TRUE);
        {
            static const int widths[] = { 250, 65, 110, 110, 65, 65, 210, 190 };
            static const char *heads[] = {
                "Process", "CPU", "Private Bytes", "Working Set",
                "PID", "Threads", "Description", "Company Name"
            };
