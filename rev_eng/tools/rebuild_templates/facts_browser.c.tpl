/* rebuilt by andy-harness reverse-engineering pipeline
 * template: facts_browser -- fallback view, works for any sample
 * generated by rebuild_gui_exe.py -- do not edit by hand
 * build  : tcc.exe -o out.exe rebuilt.c -luser32 -lgdi32 -lkernel32
 * source : run $run_id ($subject_name)
 */
#include <windows.h>
#include <string.h>

#ifndef MAX_PATH
#define MAX_PATH 260
#endif
#ifndef LR_LOADFROMFILE
#define LR_LOADFROMFILE 0x00000010
#endif
#ifndef IMAGE_ICON
#define IMAGE_ICON 1
#endif

/* ---- listview declarations (tcc has no commctrl.h) ---- */
#define LVIF_TEXT   0x0001
#define LVIF_PARAM  0x0004
#define LVCF_FMT     0x0001
#define LVCF_WIDTH   0x0002
#define LVCF_TEXT    0x0004
#define LVCF_SUBITEM 0x0008
#define LVCFMT_LEFT  0x0000
#define LVM_FIRST 0x1000
#define LVM_GETITEMA      (LVM_FIRST + 5)
#define LVM_INSERTITEMA   (LVM_FIRST + 7)
#define LVM_INSERTCOLUMNA (LVM_FIRST + 27)
#define LVM_SETITEMTEXTA  (LVM_FIRST + 46)
#define LVM_GETNEXTITEM   (LVM_FIRST + 12)
#define LVM_SETEXTENDEDLISTVIEWSTYLE (LVM_FIRST + 54)
#define LVNI_SELECTED 0x0008
#define LVS_REPORT        0x0001
#define LVS_SHOWSELALWAYS 0x0008
#define LVS_EX_FULLROWSELECT 0x00000020
#define LVS_EX_GRIDLINES     0x00000001
#define NM_DBLCLK ((UINT)-3)

typedef struct tagLVIX {
    UINT mask; int iItem; int iSubItem; UINT state; UINT stateMask;
    LPSTR pszText; int cchTextMax; int iImage; LONG_PTR lParam;
    int iIndent; int iGroupId; UINT cColumns;
    void *puColumns; int *piColFmt; int iGroup;
} LVIX;
typedef struct tagLVCX {
    UINT mask; int fmt; int cx; LPSTR pszText;
    int cchTextMax; int iSubItem; int iImage; int iOrder;
} LVCX;

#define ID_LIST     1001
#define ID_STATUS   1002
#define IDM_EXIT    2001
#define IDM_PSEUDO  2002
#define IDM_ABOUT   2003

static const char *TITLE  = $title;
static const char *SAMPLE = $sample;
static const char *SHA256 = $sha256;
static const char *KIND   = "facts_browser";

/* every row is a fact taken from the evidence bundle: {label, value} */
typedef struct tagFACT { const char *k; const char *v; } FACT;
static const FACT FACTS[] = {$facts_rows};
static const int  N_FACTS = $n_facts;

static const char *PSEUDO = $pseudo;

static char g_iconPath[MAX_PATH];
static HWND hList = 0, hStatus = 0;

static void set_col(HWND lv, int item, int sub, const char *text)
{
    LVIX lvi;
    memset(&lvi, 0, sizeof(lvi));
    lvi.mask = LVIF_TEXT;
    lvi.iItem = item;
    lvi.iSubItem = sub;
    lvi.pszText = (LPSTR)text;
    SendMessage(lv, LVM_SETITEMTEXTA, (WPARAM)item, (LPARAM)&lvi);
}

static void show_about(HWND hwnd)
{
    char msg[640];
    wsprintf(msg,
        "Generic rebuild produced by the andy-harness\n"
        "reverse-engineering pipeline.\n\n"
        "sample   : %s\n"
        "sha256   : %s\n"
        "run id   : $run_id\n"
        "template : %s\n\n"
        "No behavioural reconstruction was attempted for\n"
        "this sample: only the recovered facts are shown.",
        SAMPLE, SHA256, KIND);
    MessageBox(hwnd, msg, "About this rebuild", MB_OK | MB_ICONINFORMATION);
}

static LRESULT CALLBACK WndProc(HWND hwnd, UINT msg, WPARAM wp, LPARAM lp)
{
    switch (msg) {
    case WM_CREATE: {
        HMODULE cc = LoadLibrary("comctl32.dll");
        void (WINAPI *icc)(void);
        HICON ic;
        HFONT fnt = (HFONT)GetStockObject(DEFAULT_GUI_FONT);
        int i;
        if (cc) {
            icc = (void (WINAPI *)(void))(void *)GetProcAddress(cc, "InitCommonControls");
            if (icc) icc();
        }
        hList = CreateWindowEx(WS_EX_CLIENTEDGE, "SysListView32", "",
            WS_CHILD | WS_VISIBLE | WS_VSCROLL | LVS_REPORT | LVS_SHOWSELALWAYS,
            0, 0, 0, 0, hwnd, (HMENU)ID_LIST, GetModuleHandle(NULL), NULL);
        SendMessage(hList, WM_SETFONT, (WPARAM)fnt, TRUE);
        {
            static const int widths[] = { 220, 720 };
            static const char *heads[] = { "Item", "Value" };
            int c;
            for (c = 0; c < 2; c++) {
                LVCX col;
                memset(&col, 0, sizeof(col));
                col.mask = LVCF_FMT | LVCF_WIDTH | LVCF_TEXT | LVCF_SUBITEM;
                col.fmt = LVCFMT_LEFT;
                col.cx = widths[c];
                col.pszText = (LPSTR)heads[c];
                col.iSubItem = c;
                SendMessage(hList, LVM_INSERTCOLUMNA, (WPARAM)c, (LPARAM)&col);
            }
            SendMessage(hList, LVM_SETEXTENDEDLISTVIEWSTYLE,
                        LVS_EX_FULLROWSELECT | LVS_EX_GRIDLINES,
                        LVS_EX_FULLROWSELECT | LVS_EX_GRIDLINES);
        }
        for (i = 0; i < N_FACTS; i++) {
            LVIX lvi;
            memset(&lvi, 0, sizeof(lvi));
            lvi.mask = LVIF_TEXT | LVIF_PARAM;
            lvi.iItem = i;
            lvi.pszText = (LPSTR)FACTS[i].k;
            lvi.lParam = (LONG_PTR)i;
            SendMessage(hList, LVM_INSERTITEMA, 0, (LPARAM)&lvi);
            set_col(hList, i, 1, FACTS[i].v);
        }
        hStatus = CreateWindowEx(0, "STATIC", "",
            WS_CHILD | WS_VISIBLE | SS_LEFT,
            0, 0, 0, 20, hwnd, (HMENU)ID_STATUS, GetModuleHandle(NULL), NULL);
        SendMessage(hStatus, WM_SETFONT, (WPARAM)fnt, TRUE);
        {
            char st[256];
            wsprintf(st, "%d recovered facts    double-click a row for the full value",
                     N_FACTS);
            SetWindowText(hStatus, st);
        }
        if (g_iconPath[0]) {
            ic = (HICON)LoadImage(NULL, g_iconPath, IMAGE_ICON, 16, 16, LR_LOADFROMFILE);
            if (ic) SendMessage(hwnd, WM_SETICON, 0, (LPARAM)ic);
        }
        return 0;
    }

    case WM_SIZE: {
        int w = LOWORD(lp), h = HIWORD(lp);
        MoveWindow(hList, 0, 0, w, h - 20, TRUE);
        MoveWindow(hStatus, 0, h - 20, w, 20, TRUE);
        return 0;
    }

    case WM_COMMAND:
        switch (LOWORD(wp)) {
        case IDM_EXIT:   PostQuitMessage(0); return 0;
        case IDM_PSEUDO:
            MessageBox(hwnd, PSEUDO, "Decompiled pseudo code", MB_OK);
            return 0;
        case IDM_ABOUT:  show_about(hwnd); return 0;
        }
        return 0;

    case WM_NOTIFY: {
        NMHDR *nm = (NMHDR *)lp;
        if (nm->idFrom == ID_LIST && nm->code == (UINT)NM_DBLCLK) {
            int sel = (int)SendMessage(hList, LVM_GETNEXTITEM,
                                       (WPARAM)-1, (LPARAM)LVNI_SELECTED);
            if (sel >= 0 && sel < N_FACTS)
                MessageBox(hwnd, FACTS[sel].v, FACTS[sel].k, MB_OK);
        }
        return 0;
    }

    case WM_DESTROY:
        PostQuitMessage(0);
        return 0;
    }
    return DefWindowProc(hwnd, msg, wp, lp);
}

int WINAPI WinMain(HINSTANCE hInst, HINSTANCE hPrev, LPSTR cmd, int show)
{
    WNDCLASS wc;
    HMENU menu, file, help;
    HWND hwnd;
    MSG msg;

    if (g_iconPath[0] == 0 && $has_icon)
        lstrcpyn(g_iconPath, $icon_path, sizeof(g_iconPath));

    memset(&wc, 0, sizeof(wc));
    wc.lpfnWndProc   = WndProc;
    wc.hInstance     = hInst;
    wc.lpszClassName = "AndyHarnessRebuilt";
    wc.hbrBackground = (HBRUSH)(COLOR_WINDOW + 1);
    wc.hCursor       = LoadCursor(NULL, IDC_ARROW);
    if (g_iconPath[0]) {
        HICON big = (HICON)LoadImage(NULL, g_iconPath, IMAGE_ICON, 32, 32, LR_LOADFROMFILE);
        if (big) wc.hIcon = big;
    }
    if (!wc.hIcon) wc.hIcon = LoadIcon(NULL, IDI_APPLICATION);
    RegisterClass(&wc);

    menu = CreateMenu();
    file = CreatePopupMenu();
    AppendMenu(file, MF_STRING, IDM_EXIT, "E&xit");
    AppendMenu(menu, MF_POPUP, (UINT_PTR)file, "&File");
    help = CreatePopupMenu();
    AppendMenu(help, MF_STRING, IDM_PSEUDO, "Decompiled &code");
    AppendMenu(help, MF_STRING, IDM_ABOUT, "&About");
    AppendMenu(menu, MF_POPUP, (UINT_PTR)help, "&Help");

    hwnd = CreateWindowEx(0, "AndyHarnessRebuilt", TITLE,
        WS_OVERLAPPEDWINDOW, CW_USEDEFAULT, CW_USEDEFAULT, 960, 600,
        NULL, menu, hInst, NULL);
    ShowWindow(hwnd, show);
    UpdateWindow(hwnd);

    while (GetMessage(&msg, NULL, 0, 0)) {
        TranslateMessage(&msg);
        DispatchMessage(&msg);
    }
    return (int)msg.wParam;
}
