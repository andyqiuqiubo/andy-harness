# =============================================================================
# Andy Harness 项目 .gitignore
# 用途：排除不应上传到 GitHub 的文件/目录（依赖、构建产物、密钥、缓存、日志等）
# 维护说明：新增忽略项时请按分类追加；注释必须独占一行（gitignore 不支持行尾注释）
# =============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# 1. Python 运行时产物
# ─────────────────────────────────────────────────────────────────────────────
# Python 字节码缓存目录
__pycache__/
# 编译后的字节码文件（.pyc / .pyo / .pyd）
*.py[cod]
# Jython 等生成的类文件
*$py.class
# CPython C 扩展动态链接库
*.so
# Python Egg 包与元数据
*.egg
*.egg-info/
.eggs/
# Python 构建产物
dist/
build/
wheels/
share/python-wheels/
# 打包清单 / PyInstaller 产物
*.manifest
*.spec
# pip 安装日志与临时标记
pip-log.txt
pip-delete-this-directory.txt
MANIFEST

# Python 类型检查 / 测试 / 静态分析缓存
.mypy_cache/
.pyre/
.pytype/
.tox/
.nox/
.pytest_cache/
.coverage
htmlcov/
.ruff_cache/

# ─────────────────────────────────────────────────────────────────────────────
# 2. Python 虚拟环境与包管理器
# ─────────────────────────────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/
__pypackages__/
.python-version
.uv-cache/

# ─────────────────────────────────────────────────────────────────────────────
# 3. Java / JVM 产物（反编译器调用时可能产生）
# ─────────────────────────────────────────────────────────────────────────────
# Java 字节码 / 归档文件
*.class
*.war
*.ear
*.nar
# JVM 崩溃日志
hs_err_pid*
replay_pid*

# 注意：*.jar 不在全局忽略，因为 mcp_servers/rea 等目录可能按 VENDOR.md 提交官方原生构件。
# 如需忽略特定目录下的 jar，请在该目录或本文件项目特定区域添加。

# ─────────────────────────────────────────────────────────────────────────────
# 4. Node.js / 前端
# ─────────────────────────────────────────────────────────────────────────────
# 依赖目录与包管理器缓存
node_modules/
.npm/
.pnpm-store/
.yarn/
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*
.yarn-integrity

# 前端构建产物与开发缓存
frontend/dist/
frontend/.vite/
# Vite/CRA 本地环境文件
*.local
.vuepress/dist
.vitepress/dist
.next/
.nuxt/
.output/
.docusaurus/
.cache-loader/

# Node 调试日志
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.node_repl_history

# 前端类型检查误产出的 .js（src 为纯 TS/Vue，出现即会遮蔽 .ts 源）
frontend/src/**/*.js

# ─────────────────────────────────────────────────────────────────────────────
# 5. 桌面端（Tauri）构建产物
# ─────────────────────────────────────────────────────────────────────────────
# Rust 编译产物 / Tauri 生成代码
desktop/src-tauri/target/
desktop/src-tauri/gen/
# Tauri dev 运行产物（根目录无扩展名大写 Vite 文件）
/Vite

# ─────────────────────────────────────────────────────────────────────────────
# 6. 环境变量、密钥与敏感文件（严禁上传）
# ─────────────────────────────────────────────────────────────────────────────
# 本地环境变量文件（.env 同时匹配同名目录）
.env
.env.*
# 白名单：环境变量示例模板可入库
!.env.example
.flaskenv
# 密钥目录
secrets/
# 证书与私钥文件
*.pem
*.key
*.crt
*.p12
*.pfx
*.keystore
*.jks
# SSH 密钥
id_rsa
id_rsa.pub
# npm 配置（可能含 registry token）
.npmrc

# 项目中明文 API Key 文件（历史遗留与兜底）
key.txt
docs/key.txt
**/key.txt

# ─────────────────────────────────────────────────────────────────────────────
# 7. 数据库与本地数据文件
# ─────────────────────────────────────────────────────────────────────────────
# SQLite 数据库及日志
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm

# 后端数据目录
backend/data/
# P0-5 修复前 bug 曾把 settings 写到这里，保留忽略作为兜底
backend/harness/data/
# 冒烟测试一次性数据库
backend/.smoke-test.db

# ─────────────────────────────────────────────────────────────────────────────
# 8. IDE / 编辑器配置
# ─────────────────────────────────────────────────────────────────────────────
# JetBrains
.idea/
*.iml
*.iws
out/

# VS Code
.vscode/
.vscode-test/

# Visual Studio
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates
*.sln
*.ntvs*
*.njsproj

# Eclipse / STS
.project
.classpath
.settings/
.factorypath

# 通用编辑器临时文件
*.swp
*.swo
*~
*.orig
*.rej

# 其它 IDE / Agent
.trae/
.pydevproject
.cproject
.autotools
.buildpath
.metadata/
.recommenders/
.history/
.ionide/

# IDE / Agent 内部记忆目录（工作区级，不应入库）
.workbuddy/

# ─────────────────────────────────────────────────────────────────────────────
# 9. 操作系统生成文件
# ─────────────────────────────────────────────────────────────────────────────
# macOS
.DS_Store
.AppleDouble
.LSOverride
.Spotlight-V100/
.Trashes/
.fseventsd/
# Windows
Thumbs.db
ehthumbs.db
ehthumbs_vista.db
desktop.ini
Desktop.ini
$RECYCLE.BIN/
*.lnk
# KDE / Linux
.directory

# ─────────────────────────────────────────────────────────────────────────────
# 10. 日志文件
# ─────────────────────────────────────────────────────────────────────────────
logs/
*.log
*.log.*

# ─────────────────────────────────────────────────────────────────────────────
# 11. 临时文件与压缩包
# ─────────────────────────────────────────────────────────────────────────────
# 临时 / 备份 / 缓存
*.tmp
*.bak
*.temp
*.cache
.cache/
.temp/
tmp/
# 压缩包（通常为大工具下载产物，不应入库）
/*.zip
*.tar
*.gz
*.tgz
*.rar
*.7z
*.bz2
*.xz

# ─────────────────────────────────────────────────────────────────────────────
# 12. 工具缓存
# ─────────────────────────────────────────────────────────────────────────────
.eslintcache
.stylelintcache
.prettiercache
.pre-commit-cache/
.parcel-cache/
.turbo/

# ─────────────────────────────────────────────────────────────────────────────
# 13. 沙箱、工作区与运行时产物
# ─────────────────────────────────────────────────────────────────────────────
# 沙箱工作区
workspaces/
# 工件目录（大工具输出落盘，匹配任意层级同名目录）
workspace/
# 本地下载缓存 / 旧工具配置
.downloads/
.zcodeignore

# ─────────────────────────────────────────────────────────────────────────────
# 14. MCP 配置（可能含鉴权 header，不入库；示例见 mcp.example.json）
# ─────────────────────────────────────────────────────────────────────────────
mcp.json
backend/mcp.json

# ─────────────────────────────────────────────────────────────────────────────
# 15. REA vendored MCP server（mcp_servers/rea）构建产物
# 源码与官方原生构件入库，构建产物不入库；构建步骤见 mcp_servers/README.md
# ─────────────────────────────────────────────────────────────────────────────
mcp_servers/rea/node_modules/
mcp_servers/rea/dist/
mcp_servers/rea/skills/
mcp_servers/rea/.turbo/
mcp_servers/rea/.cache/

# ─────────────────────────────────────────────────────────────────────────────
# 16. 本地工具链（体积大、可复现下载，不入库）
# ─────────────────────────────────────────────────────────────────────────────
.tools/

# ─────────────────────────────────────────────────────────────────────────────
# 17. 逆向工程运行时产物
# ─────────────────────────────────────────────────────────────────────────────
rev_eng/runs/

# ─────────────────────────────────────────────────────────────────────────────
# 18. 本地冒烟 / 端到端脚本与临时产物
# ─────────────────────────────────────────────────────────────────────────────
smoke.bat
backend/scripts/
backend/mcp.smoke.json
frontend/.dev_*.txt
auth_test_out.txt

# ─────────────────────────────────────────────────────────────────────────────
# 19. 项目说明性 / 临时性文档（不纳入版本管理）
# 仅保留：README.md、DISCLAIMER.md、docs/andy-harness-v1.0.0用户使用手册.md
# ─────────────────────────────────────────────────────────────────────────────
README-UPDATE-*.md
CHANGELOG.md
CONTRIBUTING.md
ENHANCEMENTS.md
01-architecture.md
02-development-plan.md
docs/*.md
!docs/andy-harness-v1.0.0用户使用手册.md

# ─────────────────────────────────────────────────────────────────────────────
# 20. 版本控制元数据（非 Git）
# ─────────────────────────────────────────────────────────────────────────────
.svn/
.hg/
.bzr/

# ─────────────────────────────────────────────────────────────────────────────
# 21. 其它常见忽略
# ─────────────────────────────────────────────────────────────────────────────
*.pid
*.seed
*.pid.lock
